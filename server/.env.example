# ===========================================
# Server Environment Variables
# ===========================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ===========================================


# Server
NODE_ENV=development
PORT=5000

# Database (Supabase PostgreSQL)
DB_HOST=db.xxxxxxxxxxxx.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-database-password

# Authentication
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
ADMIN_JWT_EXPIRES_IN=8h

# One-time admin provisioning (used by `npm run admin:create`)
# Do not keep ADMIN_PASSWORD in production environment after provisioning.
ADMIN_EMAIL=admin@example.com
ADMIN_MOBILE_NUMBER=9999999999
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_FIRST_NAME=Site
ADMIN_LAST_NAME=Administrator
# Privilege level for the provisioned account: super-admin or admin.
ADMIN_ROLE=admin

# First super administrator. The seeder creates (or promotes) this account on
# startup only while no super administrator exists yet, then leaves it alone.
# Change the password right after the first sign-in.
SUPER_ADMIN_EMAIL=admin.hr@successcodeacademy.in
SUPER_ADMIN_PASSWORD=Password@123
SUPER_ADMIN_MOBILE_NUMBER=9347371746
SUPER_ADMIN_NAME=Super Administrator

# CORS
CORS_ORIGIN=http://localhost:3000

# Public website origin used to build admin password reset links.
# Leave blank to reuse the first CORS_ORIGIN entry.
APP_BASE_URL=
# How long an admin password reset link stays valid, in minutes.
ADMIN_RESET_TTL_MINUTES=60

# Email delivery via Resend (https://resend.com).
# RESEND_API_KEY is required; until it is set, all email is skipped and
# form submissions still succeed. MAIL_FROM is optional and defaults to
# "Success Code Academy <noreply@updates.successcodeacademy.in>" (the
# Resend-verified subdomain for successcodeacademy.in).
RESEND_API_KEY=
MAIL_FROM=

# Logging
LOG_LEVEL=debug

# Browser push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
